{
  "name": "financas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs dist",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
